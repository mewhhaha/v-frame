{
  "name": "@mewhhaha/v-frame",
  "version": "0.1.1",
  "description": "Render a trusted web application in a shadow tree backed by an isolated browser realm",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "./dist/register.js",
    "./src/register.ts"
  ],
  "scripts": {
    "build": "npm run typecheck && node rolldown.mjs && tsc --emitDeclarationOnly",
    "prepack": "npm run build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "size": "node scripts/bundle-size.mjs",
    "test": "npm run build && playwright test",
    "test:unit": "node --import ./scripts/resolve-ts-sources.mjs --test \"tests/unit/**/*.test.ts\"",
    "bench": "npm run build && node --import ./scripts/resolve-ts-sources.mjs bench/mark-virtual-node.ts",
    "check": "npm run format:check && npm run lint && npm run build && npm run size && npm run test:unit",
    "publish:check": "npm run check && jsr publish --dry-run"
  },
  "keywords": [
    "custom-element",
    "microfrontend",
    "shadow-dom",
    "ssr",
    "web-components"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mewhhaha/v-frame.git"
  },
  "homepage": "https://github.com/mewhhaha/v-frame#readme",
  "bugs": {
    "url": "https://github.com/mewhhaha/v-frame/issues"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "dependencies": {
    "css-tree": "3.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/css-tree": "3.2.0",
    "@types/node": "26.6.3",
    "jsr": "0.14.3",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "rolldown": "1.2.12",
    "typescript": "7.0.2"
  }
}
