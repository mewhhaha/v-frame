{
  "name": "@mewhhaha/v-frame",
  "version": "0.2.0",
  "description": "Render a trusted web application in a shadow tree backed by an isolated browser realm",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "error"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "scripts": {
    "build": "node rolldown.mjs && tsc --emitDeclarationOnly",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "typecheck": "tsc --noEmit && pnpm run typecheck:tests",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "size": "node scripts/bundle-size.mjs",
    "test:unit": "node --import ./scripts/resolve-ts-sources.mjs --test \"tests/unit/**/*.test.ts\"",
    "test:package": "node scripts/package-smoke.mjs",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "pnpm run build && playwright test --project=chromium",
    "release:check": "node scripts/release-check.ts",
    "publish:dry-run": "jsr publish --dry-run --allow-dirty",
    "bench": "pnpm run build && node --import ./scripts/resolve-ts-sources.mjs bench/mark-virtual-node.ts",
    "check:fast": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run size",
    "check": "pnpm run format:check && pnpm run lint && pnpm run build && pnpm run typecheck:tests && pnpm run size && pnpm run release:check && pnpm run test:unit && pnpm run publish:dry-run && pnpm run test:package && pnpm run test:e2e"
  },
  "keywords": [
    "custom-element",
    "microfrontend",
    "shadow-dom",
    "ssr",
    "web-components"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mewhhaha/v-frame.git"
  },
  "homepage": "https://github.com/mewhhaha/v-frame#readme",
  "bugs": {
    "url": "https://github.com/mewhhaha/v-frame/issues"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "dependencies": {
    "css-tree": "3.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/css-tree": "3.2.0",
    "@types/node": "26.6.3",
    "jsr": "0.14.3",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "rolldown": "1.2.12",
    "typescript": "7.0.2"
  }
}
