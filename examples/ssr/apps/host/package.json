{
  "name": "example-ssr-host",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run types && vite build && vite build --ssr src/index.ts",
    "dev": "pnpm run build && wrangler dev",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "types": "wrangler types worker-configuration.d.ts"
  },
  "dependencies": {
    "@mewhhaha/v-frame": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wrangler": "4.145.0"
  }
}
