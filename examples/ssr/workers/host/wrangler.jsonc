{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "v-frame-example-composed-host",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    { "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }
  ],
  "services": [
    { "binding": "REACT_ROUTER_WIDGET", "service": "v-frame-example-react-router-widget" },
    { "binding": "QWIK_WIDGET", "service": "v-frame-example-qwik-widget" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
