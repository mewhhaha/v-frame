{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The root project emits declarations out of "src" (and `pnpm build` thereby
    // typechecks it); this project only checks.
    "noEmit": true,
    "declaration": false,
    "emitDeclarationOnly": false,
    "rootDir": ".",
    // The fixture servers run on Node, so the specs need the Node globals that
    // the browser-only root project deliberately leaves out.
    "types": ["node"],
    // The client example's host is React, and nothing else in this project is
    // JSX, so the setting is free to be the one that host needs.
    "jsx": "react-jsx",
    // That host imports the package by its public name. `dist/` only exists
    // after `pnpm build`, and this project must typecheck without it, so resolve
    // the name to the sources instead of to the declarations built there.
    "paths": {
      "@mewhhaha/v-frame": ["./src/index.ts"],
      "@mewhhaha/v-frame/register": ["./src/register.ts"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "bench/**/*.ts",
    "examples/*/tests/**/*.ts",
    "examples/client/src/**/*.ts",
    "examples/client/src/**/*.tsx",
    "examples/ssr/apps/host/src/client.ts",
    "examples/ssr/apps/host/src/host-config.ts",
    "examples/client/vite.config.ts"
  ],
  "exclude": ["tests/package-consumer"]
}
